#taglist
  - tags = count_tags()
  - tags.each.sort_by {|k,v| k}.each do |tag_count|
    - tag = tag_count[0]
    %a(href='#{relative_path_to("#{blog_url}tags/#{tag}/")}' class='tag')= tag
