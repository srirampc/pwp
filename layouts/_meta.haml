---
---
- if item[:kind] == 'article'
  .meta
    %ul.tags
      %li= pretty_time(item[:created_at])
      - if disqus_shortname 
        - @config[:include_disqus_js] = true
        %li
          &middot;
        %li
          %a(href="#{route_path_relative(item)}#disqus_thread")
      - if item[:tags]
        %li &middot;
        - item[:tags].sort.each do |tag|
          %li
            %a(href='#{relative_path_to("#{blog_url}tags/#{tag}/")}' class='tag')
              = tag
